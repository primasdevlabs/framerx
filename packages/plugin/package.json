{
  "name": "@framer/plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FramerX — export production-ready React projects from Framer with one click.",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@framer/compiler": "workspace:*",
    "@framer/compiler-parser": "workspace:*",
    "@framer/plugin": "^4",
    "jszip": "^3.10.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.1",
    "vite-plugin-framer": "^1.1.1",
    "vite-plugin-mkcert": "^2.1.0"
  }
}
