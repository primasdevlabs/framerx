    "content": "import { Card } from '../components/Card';
import { Button } from '../components/Button';
interface CardGridSectionProps {
    className?: string;
}

export function CardGridSection({ className }: CardGridSectionProps) {
    return (
        <section
            className={className ?? 'w-full h-100 p-20 flex flex-row items-stretch justify-between gap-6 bg-slate-50'}
        >
            <Card
                icon={
                    <svg className="w-6 h-6" viewBox="0 0 24 24">
                        <path d="M12 2l3 7 7 .9-5 4.9 1.5 7L12 18l-6.5 3.8L7 14.8 2 9.9 9 9z" fill="#f59e0b" />
                    </svg>
                }
                content={<p className="w-68 h-12 text-base text-slate-700">Custom body one</p>}
            />
            <Card content={<p className="w-68 h-12 text-base text-slate-700">Custom body two</p>} />
            <Button />
        </section>
    );
}
