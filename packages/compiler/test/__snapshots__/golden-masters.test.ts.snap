  {
    "content": "import type { ReactNode } from 'react';
import { Button } from './Button';
interface CardProps {
    className?: string;
    icon?: ReactNode;
    content?: ReactNode;
}

export function Card({ className, icon, content }: CardProps) {
    return (
        <div
            className={className ?? 'w-80 h-65 p-6 flex flex-col items-start justify-start gap-3 bg-white rounded-2xl'}
        >
            <p className="w-50 h-6 text-lg font-bold text-slate-900">Card Title</p>
            {icon ?? (
                <>
                    <Button size="md" />
                </>
            )}
            {content ?? (
                <>
                    <p className="w-68 h-12 text-base text-slate-700 leading-normal">Default card body</p>
                </>
            )}
            <p className="w-50 h-5 text-sm font-semibold text-slate-500">Card Footer</p>
        </div>
    );
}
