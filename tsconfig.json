{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023"
    ],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "references": [
    {
      "path": "./packages/ast"
    },
    {
      "path": "./packages/shared"
    },
    {
      "path": "./packages/parser"
    },
    {
      "path": "./packages/generators"
    },
    {
      "path": "./packages/formatter"
    },
    {
      "path": "./packages/zip"
    },
    {
      "path": "./packages/compiler"
    },
    {
      "path": "./packages/plugin"
    }
  ]
}